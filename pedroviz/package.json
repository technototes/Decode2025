{
  "name": "pedro-viz",
  "repository": "https://github.com/technototes/Decode2025.git",
  "author": "Kevin Frei <kevinfrei@hotmail.com>",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "format": "prettier -w \"*.ts*\" \"client/**/*.tsx\"  \"client/**/*.ts\" \"server/**/*.ts\" \"*.md\" \"*.json\" \"*.html\" \"server/**/*.java\"",
    "types": "tsc --noEmit",
    "pvdev": "bun --hot index.tsx",
    "pvbld": "bun build ./index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "pvstart": "NODE_ENV=production bun index.tsx",
    "dead": "knip"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.6",
    "@fluentui/react-icons": "^2.0.337",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@freik/containers": "^0.4.10",
    "@freik/fluent9-tools": "^0.2.0",
    "@freik/react-tools": "^0.4.0",
    "@freik/typechk": "^0.10.0",
    "java-parser": "^3.0.1",
    "jotai": "^2.20.2",
    "jotai-family": "^1.1.0",
    "jotai-optics": "^0.4.0",
    "optics-ts": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "typescript": "^7.0.2"
  },
  " //-1": "Configuration stuff for Prettier:",
  "prettier": {
    "printWidth": 80,
    "trailingComma": "all",
    "singleQuote": true,
    "proseWrap": "always",
    "tabWidth": 2,
    "useTabs": false,
    "bracketSameLine": true,
    "arrowParens": "always",
    "plugins": [
      "prettier-plugin-java",
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^bun:.*$",
      "^node:.*$",
      "^react$",
      "^react-dom$",
      "^react-dom/client$",
      "^.*jotai.*$",
      "",
      "<THIRD_PARTY_MODULES>",
      "^@freik/.*$",
      "",
      "^(?!.*[.]css$)[./].*$",
      "",
      ".css$"
    ],
    "overrides": [
      {
        "files": "*.java",
        "options": {
          "tabWidth": 4,
          "printWidth": 100,
          "arrowParens": "avoid"
        }
      }
    ]
  },
  " //-2": "Configuration stuff for knip:",
  "knip": {
    "entry": [
      "index.tsx",
      "client/frontend.tsx"
    ],
    "ignore": [
      "client/__tests__/**/*",
      "server/__tests__/**/*"
    ]
  }
}
