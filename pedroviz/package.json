{
  "name": "pedro-viz",
  "repository": "https://github.com/technototes/Decode2025.git",
  "author": "Kevin Frei <kevinfrei@hotmail.com>",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "format": "prettier -w \"*.ts*\" \"client/**/*.tsx\"  \"client/**/*.ts\" \"server/**/*.ts\" \"*.md\" \"*.json\" \"*.html\"",
    "types": "tsc --noEmit",
    "pvdev": "bun --hot index.tsx",
    "pvbld": "bun build ./index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "pvstart": "NODE_ENV=production bun index.tsx"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.333",
    "@freik/containers": "^0.4.10",
    "@freik/fluentui-tools": "^1.2.10",
    "@freik/react-tools": "^0.3.11",
    "@freik/typechk": "^0.9.6",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "java-parser": "^3.0.1",
    "jotai": "^2.20.2",
    "jotai-family": "^1.0.2",
    "jotai-optics": "^0.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "prettier": {
    "printWidth": 80,
    "trailingComma": "all",
    "singleQuote": true,
    "proseWrap": "always",
    "tabWidth": 2,
    "useTabs": false,
    "bracketSameLine": true,
    "arrowParens": "always",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^react$",
      "^react-dom$",
      "^react-dom/client$",
      "^.*jotai.*$",
      "",
      "<THIRD_PARTY_MODULES>",
      "^@freik/.*$",
      "",
      "^(?!.*[.]css$)[./].*$",
      "",
      ".css$"
    ]
  }
}
